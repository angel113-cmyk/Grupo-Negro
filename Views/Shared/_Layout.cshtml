<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Grupo_negro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm custom-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand custom-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="color:#fff; background:#b00; padding:6px 18px; border-radius:8px; font-size:1.5em; font-weight:bold; box-shadow:0 2px 8px #b00a;">APUESTA</span>
                    <span style="color:#222; font-size:1.3em; font-weight:bold; margin-left:8px;">KONGNOSTROS</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Enlaces principales (izquierda) -->
                    <ul class="navbar-nav custom-nav">
                        <li class="nav-item">
                            <a class="nav-link custom-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle custom-link" href="#" id="apuestasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-futbol"></i> Apuestas
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="apuestasDropdown">
                                    <li><a class="dropdown-item" asp-controller="Apuestas" asp-action="Index">
                                        <i class="fas fa-list me-2"></i>Ver Apuestas
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Apuestas" asp-action="CarritoApuestas">
                                        <i class="fas fa-shopping-cart me-2"></i>Carrito 
                                        <span class="badge bg-primary ms-1" id="navCarritoContador" style="display: none;">0</span>
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Apuestas" asp-action="MisApuestas">
                                        <i class="fas fa-history me-2"></i>Mis Apuestas
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Apuestas" asp-action="MisApuestasCombinadas">
                                        <i class="fas fa-layer-group me-2"></i>Apuestas Combinadas
                                    </a></li>
                                </ul>
                            </li>
                            @* FUNCIONALIDAD ADMIN - COMENTADA TEMPORALMENTE *@
                            @* @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link custom-link" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-cog"></i> Panel Admin
                                    </a>
                                </li>
                            } *@
                        }
                        <li class="nav-item">
                            <a class="nav-link custom-link" asp-area="" asp-controller="Comentarios" asp-action="Index">
                                <i class="fas fa-comments"></i> Comentarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-link" asp-area="" asp-controller="Tienda" asp-action="Index">Nosotros</a>
                        </li>
                    </ul>

                    <!-- Acciones de usuario (derecha) -->
                    <ul class="navbar-nav ms-auto custom-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle custom-link" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user"></i> @await Component.InvokeAsync("NombreUsuario")
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    @if (FeatureFlags.SISTEMA_SALDO_HABILITADO)
                                    {
                                        <li><span class="dropdown-item-text"><i class="fas fa-wallet"></i> Saldo: @await Component.InvokeAsync("SaldoUsuario")</span></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <!-- Opciones de Tema -->
                                    <li><h6 class="dropdown-header"><i class="fas fa-palette"></i> Cambiar Tema</h6></li>
                                    <li><a class="dropdown-item" href="#" onclick="cambiarTema('claro'); return false;"><i class="fas fa-sun"></i> Tema Claro</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="cambiarTema('oscuro'); return false;"><i class="fas fa-moon"></i> Tema Oscuro</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (FeatureFlags.DEPOSITOS_RETIROS_HABILITADO)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Saldo" asp-action="Index"><i class="fas fa-user-cog"></i> Mi Perfil</a></li>
                                        <li><a class="dropdown-item" asp-controller="Saldo" asp-action="Depositar"><i class="fas fa-plus-circle"></i> Depositar</a></li>
                                        <li><a class="dropdown-item" asp-controller="Saldo" asp-action="Retirar"><i class="fas fa-minus-circle"></i> Retirar</a></li>
                                        <li><a class="dropdown-item" asp-controller="Saldo" asp-action="Historial"><i class="fas fa-history"></i> Historial</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt"></i> Cerrar sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link custom-link" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Registrarse
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link custom-link" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        <style>
            .custom-navbar {
                background: linear-gradient(90deg, #b00 0%, #2a2222 100%);
                box-shadow: 0 4px 16px #b00a;
                border-bottom: 3px solid #fff4f4;
                padding: 0;
            }
            .custom-brand {
                display: flex;
                align-items: center;
                gap: 8px;
                letter-spacing: 1px;
            }
            .custom-nav {
                display: flex;
                gap: 18px;
                margin-left: 30px;
            }
            .custom-link {
                color: #fff !important;
                font-weight: bold;
                font-size: 1.1em;
                padding: 10px 18px;
                border-radius: 6px;
                transition: background 0.2s, color 0.2s, transform 0.2s;
            }
            .custom-link:hover {
                background: #fff4f4;
                color: #b00 !important;
                transform: scale(1.08);
                box-shadow: 0 2px 8px #b00a;
            }
        </style>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Grupo_negro - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Script para cambio de tema desde el menú de navegación -->
    <script>
        // Función para cambiar tema desde el menú
        function cambiarTema(tema) {
            fetch('@Url.Action("CambiarTema", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'tema=' + encodeURIComponent(tema)
            })
            .then(response => {
                if (response.ok) {
                    // Aplicar el tema inmediatamente
                    aplicarTema(tema);
                    
                    // Mostrar notificación de éxito
                    mostrarNotificacionTema(tema);
                } else {
                    console.error('Error al cambiar tema');
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }

        // Función para aplicar el tema visualmente
        function aplicarTema(tema) {
            const body = document.body;
            
            // Remover clases de tema existentes
            body.classList.remove('tema-claro', 'tema-oscuro');
            
            // Agregar la nueva clase de tema
            if (tema === 'oscuro') {
                body.classList.add('tema-oscuro');
            } else if (tema === 'claro') {
                body.classList.add('tema-claro');
            }
        }

        // Función para mostrar notificación temporal
        function mostrarNotificacionTema(tema) {
            // Crear elemento de notificación
            const notificacion = document.createElement('div');
            notificacion.className = 'alert alert-success alert-dismissible fade show position-fixed';
            notificacion.style.cssText = 'top: 80px; right: 20px; z-index: 9999; min-width: 300px;';
            notificacion.innerHTML = `
                <i class="fas fa-palette me-2"></i>Tema ${tema} aplicado correctamente!
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            // Agregar al documento
            document.body.appendChild(notificacion);
            
            // Remover automáticamente después de 3 segundos
            setTimeout(() => {
                if (notificacion.parentNode) {
                    notificacion.parentNode.removeChild(notificacion);
                }
            }, 3000);
        }

        // Aplicar tema al cargar la página basado en la cookie
        document.addEventListener('DOMContentLoaded', function() {
            // Obtener tema desde ViewBag o detectar desde las cookies del servidor
            @if (ViewBag.TemaPreferido != null)
            {
                <text>
                const temaActual = '@ViewBag.TemaPreferido';
                if (temaActual && temaActual !== '') {
                    aplicarTema(temaActual);
                }
                </text>
            }
        });
    </script>
</body>
</html>
