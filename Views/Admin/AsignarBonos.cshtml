@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Asignar Bonos";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2><i class="fas fa-gift"></i> Asignar Bonos a Usuarios</h2>
                    <p class="text-muted">Otorga bonos de saldo a los usuarios del sistema</p>
                </div>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver al Panel
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-users"></i> Lista de Usuarios</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <input type="text" id="searchUsuario" class="form-control" placeholder="Buscar por nombre, email o DNI...">
                    </div>

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover" id="tablaUsuarios">
                                <thead class="table-dark">
                                    <tr>
                                        <th>DNI</th>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th>Saldo Actual</th>
                                        <th>Bonos Recibidos</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in Model)
                                    {
                                        <tr id="usuario-@usuario.Id" class="usuario-row">
                                            <td>@(usuario.DNI ?? "Sin DNI")</td>
                                            <td>@usuario.NombreCompleto</td>
                                            <td>@usuario.Email</td>
                                            <td>
                                                <span class="badge bg-success">
                                                    $@usuario.Saldo.ToString("N2")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @usuario.Bonos.Count bonos
                                                </span>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-warning" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#modalBono"
                                                        data-usuario-id="@usuario.Id"
                                                        data-usuario-nombre="@usuario.NombreCompleto">
                                                    <i class="fas fa-plus"></i> Asignar Bono
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay usuarios registrados.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para asignar bono -->
<div class="modal fade" id="modalBono" tabindex="-1" aria-labelledby="modalBonoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AsignarBono" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="modalBonoLabel">
                        <i class="fas fa-gift"></i> Asignar Bono
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="usuarioId" name="usuarioId" />
                    
                    <div class="mb-3">
                        <label class="form-label"><strong>Usuario:</strong></label>
                        <p id="usuarioNombre" class="form-control-plaintext bg-light p-2 rounded"></p>
                    </div>

                    <div class="mb-3">
                        <label for="concepto" class="form-label">Concepto del Bono:</label>
                        <select class="form-select" id="concepto" name="concepto" required>
                            <option value="">Seleccionar concepto...</option>
                            <option value="Bono de Bienvenida">Bono de Bienvenida</option>
                            <option value="Bono por Recarga">Bono por Recarga</option>
                            <option value="Bono Promocional">Bono Promocional</option>
                            <option value="Compensación">Compensación</option>
                            <option value="Bono Especial">Bono Especial</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>

                    <div class="mb-3" id="otroConceptoDiv" style="display: none;">
                        <label for="otroConcepto" class="form-label">Especificar Concepto:</label>
                        <input type="text" class="form-control" id="otroConcepto" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label for="monto" class="form-label">Monto del Bono:</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="monto" name="monto" 
                                   min="0.01" step="0.01" required placeholder="0.00" />
                        </div>
                        <small class="text-muted">Este monto se agregará al saldo del usuario.</small>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> 
                        El bono se aplicará inmediatamente al saldo del usuario.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-check"></i> Asignar Bono
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal de asignar bono
        var modalBono = document.getElementById('modalBono');
        modalBono.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var usuarioId = button.getAttribute('data-usuario-id');
            var usuarioNombre = button.getAttribute('data-usuario-nombre');
            
            document.getElementById('usuarioId').value = usuarioId;
            document.getElementById('usuarioNombre').textContent = usuarioNombre;
            document.getElementById('concepto').value = '';
            document.getElementById('monto').value = '';
            document.getElementById('otroConceptoDiv').style.display = 'none';
        });

        // Mostrar campo de concepto personalizado
        document.getElementById('concepto').addEventListener('change', function() {
            var otroDiv = document.getElementById('otroConceptoDiv');
            if (this.value === 'Otro') {
                otroDiv.style.display = 'block';
            } else {
                otroDiv.style.display = 'none';
            }
        });

        // Usar el concepto personalizado si se selecciona "Otro"
        document.querySelector('form').addEventListener('submit', function(e) {
            var concepto = document.getElementById('concepto');
            if (concepto.value === 'Otro') {
                var otroConcepto = document.getElementById('otroConcepto').value;
                if (otroConcepto.trim() === '') {
                    e.preventDefault();
                    alert('Por favor especifica el concepto del bono.');
                    return false;
                }
                concepto.value = otroConcepto;
            }
        });

        // Búsqueda de usuarios
        document.getElementById('searchUsuario').addEventListener('keyup', function() {
            var searchText = this.value.toLowerCase();
            var rows = document.querySelectorAll('.usuario-row');
            
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                if (text.includes(searchText)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}
